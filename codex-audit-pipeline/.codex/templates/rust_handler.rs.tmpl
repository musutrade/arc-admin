// 使用前替换: {{ENTITY_NAME}}（模块名用 {{entity_name}} 小写形式）
// 注意: Handler 层禁止 SQL（audit 拦截），只允许调用 services
// 风格与 backend/src/handlers/*.rs 一致：
//   axum + State<AppState> + AuthUser（需要登录的路由都带 _auth: AuthUser）
// 参考实现: backend/src/handlers/users.rs
use crate::auth::AuthUser;
use crate::error::ApiError;
use crate::models::{
    {{ENTITY_NAME}}CreateRequest, {{ENTITY_NAME}}Response, PageQuery, Page{{ENTITY_NAME}},
};
use crate::services;
use crate::AppState;
use axum::extract::{Path, Query, State};
use axum::http::StatusCode;
use axum::Json;

pub async fn list(
    State(state): State<AppState>,
    _auth: AuthUser,
    Query(query): Query<PageQuery>,
) -> Result<Json<Page{{ENTITY_NAME}}>, ApiError> {
    services::{{entity_name}}::list(&state.pool, &query).await.map(Json)
}

pub async fn get(
    State(state): State<AppState>,
    _auth: AuthUser,
    Path(id): Path<i64>,
) -> Result<Json<{{ENTITY_NAME}}Response>, ApiError> {
    services::{{entity_name}}::get(&state.pool, id).await.map(Json)
}

pub async fn create(
    State(state): State<AppState>,
    _auth: AuthUser,
    Json(req): Json<{{ENTITY_NAME}}CreateRequest>,
) -> Result<(StatusCode, Json<{{ENTITY_NAME}}Response>), ApiError> {
    services::{{entity_name}}::create(&state.pool, &req)
        .await
        .map(|data| (StatusCode::CREATED, Json(data)))
}

pub async fn delete(
    State(state): State<AppState>,
    _auth: AuthUser,
    Path(id): Path<i64>,
) -> Result<StatusCode, ApiError> {
    services::{{entity_name}}::delete(&state.pool, id).await?;
    Ok(StatusCode::NO_CONTENT)
}
