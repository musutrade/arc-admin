// 使用前替换: {{ENTITY_NAME}}
// 注意: Handler 层禁止出现 SQL (auditor 会拦截), 只允许调用 Service
use actix_web::{web, HttpResponse, Responder};
use serde_json::json;
use crate::services::{{ENTITY_NAME}}Service;

#[derive(Clone)]
pub struct {{ENTITY_NAME}}Handler {
    service: {{ENTITY_NAME}}Service,
}

impl {{ENTITY_NAME}}Handler {
    pub fn new(service: {{ENTITY_NAME}}Service) -> Self {
        Self { service }
    }

    pub async fn find_by_id(
        service: web::Data<{{ENTITY_NAME}}Handler>,
        path: web::Path<i64>,
    ) -> impl Responder {
        let id = path.into_inner();
        match service.service.get_by_id(id).await {
            Ok(Some(data)) => HttpResponse::Ok().json(json!({ "data": data })),
            Ok(None) => HttpResponse::NotFound().json(json!({ "error": "Not Found" })),
            Err(e) => HttpResponse::InternalServerError().json(json!({ "error": e.to_string() })),
        }
    }

    pub async fn list(
        service: web::Data<{{ENTITY_NAME}}Handler>,
        query: web::Query<PageQuery>,
    ) -> impl Responder {
        let page = query.page.unwrap_or(1);
        let size = query.size.unwrap_or(10);
        match service.service.list(page, size).await {
            Ok(data) => {
                HttpResponse::Ok().json(json!({ "data": data, "page": page, "size": size }))
            }
            Err(e) => HttpResponse::InternalServerError().json(json!({ "error": e.to_string() })),
        }
    }

    pub async fn create(
        service: web::Data<{{ENTITY_NAME}}Handler>,
        body: web::Json<{{ENTITY_NAME}}CreateDto>,
    ) -> impl Responder {
        match service.service.create(body.into_inner()).await {
            Ok(data) => HttpResponse::Created().json(json!({ "data": data })),
            Err(e) => HttpResponse::BadRequest().json(json!({ "error": e.to_string() })),
        }
    }
}

#[derive(Debug, serde::Deserialize)]
pub struct PageQuery {
    pub page: Option<i64>,
    pub size: Option<i64>,
}
